# Skills Platform - Configuración
# Copia este archivo a .env y configura los valores

# API Key de Anthropic (REQUERIDO)
ANTHROPIC_API_KEY=tu-api-key-aqui

# Modelo de Claude a usar
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Clave secreta para JWT (cambiar en producción)
SECRET_KEY=tu-clave-secreta-super-segura-cambiar-en-produccion-123456789

# Directorio donde están los skills
SKILLS_DIRECTORY=/ruta/a/tus/skills

# Debug mode
DEBUG=false
